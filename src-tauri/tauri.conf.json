{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yarik Weather",
  "version": "0.1.0",
  "identifier": "com.yarikstudio.yarikweather",
  "build": {
    "frontendDist": "../frontend/dist-android"
  },
  "app": {
    "windows": [
      {
        "title": "Yarik Weather",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
